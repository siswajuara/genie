{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Siswa Juara canvas document",
  "type": "object",
  "required": ["version", "metadata", "elements"],
  "properties": {
    "version": { "const": 1 },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "updatedAt": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "dateRange": {
          "type": "object",
          "required": ["from"],
          "properties": {
            "from": { "type": "string", "format": "date" },
            "to": { "type": "string", "format": "date" }
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/element" }
    }
  },
  "$defs": {
    "easing": {
      "enum": [
        "linear",
        "ease-in",
        "ease-out",
        "ease-in-out",
        "back-out",
        "sine-in-out",
        "bounce-out",
        "elastic-out"
      ]
    },
    "motion": {
      "type": "object",
      "required": ["preset", "amount", "easing"],
      "properties": {
        "preset": {
          "enum": [
            "none",
            "float",
            "pulse",
            "pan-left",
            "pan-right",
            "zoom-in",
            "zoom-out",
            "dolly-in",
            "dolly-out",
            "sway",
            "rock",
            "orbit",
            "breathe",
            "pan-up",
            "pan-down",
            "rotate-clockwise",
            "rotate-counterclockwise"
          ]
        },
        "amount": { "type": "number", "minimum": 0, "maximum": 500 },
        "easing": { "$ref": "#/$defs/easing" }
      }
    },
    "effect": {
      "type": "object",
      "required": ["preset", "duration", "amount", "easing"],
      "properties": {
        "preset": {
          "enum": [
            "none",
            "fade",
            "slide-left",
            "slide-right",
            "slide-up",
            "slide-down",
            "zoom",
            "zoom-3d",
            "flip",
            "spin",
            "pop",
            "bounce",
            "elastic",
            "rise",
            "drop",
            "swing",
            "rotate-in",
            "zoom-out",
            "reveal-left",
            "reveal-right",
            "reveal-up",
            "reveal-down"
          ]
        },
        "duration": { "type": "number", "minimum": 0.05, "maximum": 600 },
        "amount": { "type": "number", "minimum": 0, "maximum": 500 },
        "easing": { "$ref": "#/$defs/easing" }
      }
    },
    "keyframe": {
      "type": "object",
      "required": [
        "time",
        "x",
        "y",
        "scale",
        "rotation",
        "opacity",
        "rotateY",
        "z",
        "easing"
      ],
      "properties": {
        "time": { "type": "number", "minimum": 0, "maximum": 600 },
        "x": { "type": "number", "minimum": -10000, "maximum": 10000 },
        "y": { "type": "number", "minimum": -10000, "maximum": 10000 },
        "scale": { "type": "number", "minimum": 0.01, "maximum": 20 },
        "rotation": { "type": "number", "minimum": -10000, "maximum": 10000 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "rotateY": { "type": "number", "minimum": -10000, "maximum": 10000 },
        "z": { "type": "number", "minimum": -10000, "maximum": 10000 },
        "easing": { "$ref": "#/$defs/easing" }
      }
    },
    "textAnimation": {
      "type": "object",
      "required": ["preset", "duration", "delay", "easing"],
      "description": "Text elements only. Reveal progress changes glyph visibility and transforms without changing layout, line breaks, or inline colors. Timings are relative to the layer start; reveal duration fits the remaining layer lifetime.",
      "properties": {
        "preset": {
          "enum": [
            "none",
            "typewriter",
            "word-by-word",
            "line-by-line",
            "character-fade",
            "character-rise",
            "word-rise",
            "word-pop",
            "wave"
          ]
        },
        "duration": { "type": "number", "minimum": 0.05, "maximum": 600 },
        "delay": { "type": "number", "minimum": 0, "maximum": 600 },
        "easing": { "$ref": "#/$defs/easing" },
        "reverse": { "type": "boolean" }
      }
    },
    "animation": {
      "type": "object",
      "description": "Element-local animation. start/end are scene seconds. Keyframe time is relative to start; keyframes must be sorted with unique times. All transform values are offsets from the editable design, scale and opacity are multipliers.",
      "properties": {
        "start": { "type": "number", "minimum": 0, "maximum": 600 },
        "end": { "type": "number", "minimum": 0.05, "maximum": 600 },
        "depth": { "type": "number", "minimum": -500, "maximum": 500 },
        "enter": { "$ref": "#/$defs/effect" },
        "exit": { "$ref": "#/$defs/effect" },
        "motion": { "$ref": "#/$defs/motion" },
        "text": { "$ref": "#/$defs/textAnimation" },
        "keyframes": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/keyframe" }
        }
      }
    },
    "scene": {
      "type": "object",
      "required": ["duration"],
      "description": "Frame-only video scene. Default duration is 5 seconds. Transition belongs to the outgoing frame and overlaps the next scene by at most half of either scene duration.",
      "properties": {
        "duration": { "type": "number", "minimum": 0.1, "maximum": 600 },
        "camera": { "$ref": "#/$defs/motion" },
        "transition": {
          "type": "object",
          "required": ["type", "duration"],
          "properties": {
            "type": {
              "enum": [
                "cut",
                "crossfade",
                "slide-left",
                "slide-right",
                "slide-up",
                "wipe",
                "zoom",
                "slide-down",
                "push-left",
                "push-right",
                "push-up",
                "push-down",
                "wipe-right",
                "wipe-up",
                "wipe-down",
                "circle-in",
                "circle-out",
                "diamond",
                "blinds",
                "fade-through-black",
                "fade-through-white",
                "zoom-out",
                "spin"
              ]
            },
            "duration": { "type": "number", "minimum": 0.05, "maximum": 10 },
            "easing": { "$ref": "#/$defs/easing" }
          }
        }
      }
    },
    "audioTrack": {
      "type": "object",
      "required": [
        "id",
        "name",
        "src",
        "role",
        "start",
        "end",
        "trimStart",
        "sourceDuration",
        "volume",
        "loop",
        "muted",
        "fadeIn",
        "fadeOut"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "maxLength": 200 },
        "src": {
          "type": "string",
          "pattern": "^data:audio/(mpeg|mp3|wav|x-wav|wave|ogg|mp4|aac|flac|webm|x-m4a);base64,[A-Za-z0-9+/]+=*$"
        },
        "role": { "enum": ["voiceover", "music", "sound"] },
        "start": { "type": "number", "minimum": 0, "exclusiveMaximum": 600 },
        "end": { "type": "number", "exclusiveMinimum": 0, "maximum": 600 },
        "trimStart": { "type": "number", "minimum": 0 },
        "sourceDuration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "loop": { "type": "boolean" },
        "muted": { "type": "boolean" },
        "fadeIn": { "type": "number", "minimum": 0, "maximum": 600 },
        "fadeOut": { "type": "number", "minimum": 0, "maximum": 600 }
      }
    },
    "subtitleCue": {
      "type": "object",
      "required": ["id", "start", "end", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "start": { "type": "number", "minimum": 0, "exclusiveMaximum": 600 },
        "end": { "type": "number", "exclusiveMinimum": 0, "maximum": 600 },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "t", "n", "x", "y", "w", "h"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "identifier": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Editable semantic slug, independent of the stable id. Images use searchable-name-color-facing, for example laptop-computer-blue-front."
        },
        "t": {
          "enum": ["frame", "text", "rect", "ellipse", "line", "img", "video"]
        },
        "n": { "type": "string" },
        "fid": {
          "type": "string",
          "description": "Parent frame ID. Coordinates remain absolute."
        },
        "gid": {
          "type": "string",
          "description": "Elements sharing this ID select as a group."
        },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" },
        "text": { "type": "string" },
        "font": { "type": "string" },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "weight": { "type": "number" },
        "color": { "type": "string" },
        "align": { "enum": ["left", "center", "right"] },
        "curve": { "type": "number" },
        "ls": { "type": "number" },
        "lh": { "type": "number" },
        "tstroke": { "type": "string" },
        "tsw": { "type": "number", "minimum": 0 },
        "fill": { "type": "string" },
        "fill2": { "type": "string" },
        "stroke": { "type": "string" },
        "lw": { "type": "number", "minimum": 0 },
        "r": { "type": "number", "minimum": 0 },
        "bend": { "type": "number" },
        "dash": { "type": "number" },
        "src": { "type": "string" },
        "videoStart": { "type": "number", "minimum": 0, "maximum": 100000 },
        "videoLoop": { "type": "boolean" },
        "chromaKey": {
          "type": "object",
          "required": ["enabled", "color", "tolerance", "softness", "spill"],
          "properties": {
            "enabled": { "type": "boolean" },
            "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "tolerance": { "type": "number", "minimum": 0, "maximum": 1 },
            "softness": { "type": "number", "minimum": 0, "maximum": 1 },
            "spill": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "fit": { "enum": ["contain", "cover"] },
        "label": { "type": "string" },
        "rot": { "type": "number" },
        "op": { "type": "number", "minimum": 0, "maximum": 1 },
        "hide": { "type": "boolean" },
        "lock": { "type": "boolean" },
        "sh": { "type": "number", "minimum": 0 },
        "shc": { "type": "string" },
        "shx": { "type": "number" },
        "shy": { "type": "number" },
        "animation": { "$ref": "#/$defs/animation" },
        "scene": { "$ref": "#/$defs/scene" },
        "audioTracks": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/audioTrack" },
          "description": "Frame-owned embedded audio. Times are scene seconds; trimStart is a source offset. Music, speech and effects mix during playback and MP4 export."
        },
        "voiceoverDraft": {
          "type": "object",
          "required": [
            "script",
            "voiceId",
            "accountId",
            "language",
            "subtitles"
          ],
          "properties": {
            "script": { "type": "string", "maxLength": 5000 },
            "voiceId": { "type": "string", "maxLength": 100 },
            "accountId": { "type": "string", "maxLength": 80 },
            "language": { "type": "string", "maxLength": 3 },
            "subtitles": { "type": "boolean" }
          }
        },
        "subtitles": {
          "type": "array",
          "maxItems": 2000,
          "items": { "$ref": "#/$defs/subtitleCue" },
          "description": "Frame-owned editable captions. Times are scene seconds; captions are burned into exports."
        },
        "subtitleStyle": {
          "type": "object",
          "required": ["size", "color", "background", "position"],
          "properties": {
            "size": { "type": "number", "minimum": 1, "maximum": 15 },
            "color": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "background": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "position": { "enum": ["bottom", "center", "top"] }
          }
        }
      }
    }
  }
}
