{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "genie",
  "version": "0.1.0",
  "identifier": "com.siswajuara.genie",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar:prepare && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Genie by SiswaJuara",
        "width": 1440,
        "height": 960,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "resources": { "resources/sidecar/": "sidecar/" },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/siswajuara/genie/releases/latest/download/latest.json"],
      "windows": {"installMode":"passive"}
    }
  }
}
